# -*- Tcl -*-
# Exercise the actual send -> SMTP listener -> STARTTLS relay path.
if {![info exists ::env(ALIAS_TEST_MODE)] || $::env(ALIAS_TEST_MODE) ne "proxy"} {return}
package require tcltest 2.2
namespace import ::tcltest::*
configure {*}$argv
testConstraint fullsuite [expr {[configure -match] eq "*" && [configure -skip] eq ""}]
nsv_set alias-test calls 0
nsv_set alias-test policy {}

test alias-proxy-1 {send through the listener safely resolves aliases twice} -body {
    set message "From: sender@remote.test\r\nTo: webmaster@example.test\r\n\r\nBody"
    ns_smtpd send sender@remote.test webmaster@example.test message 127.0.0.1 $::env(ALIAS_TEST_PORT)
} -result {}

test alias-proxy-2 {mixed target routes fall back to the default relay} -body {
    # Port 1 deliberately must not be used for a mixed-domain transaction.
    ns_smtpd relay set example.test remote.test:127.0.0.1:1
    set socket [socket 127.0.0.1 $::env(ALIAS_TEST_PORT)]
    fconfigure $socket -translation crlf -buffering line
    gets $socket
    foreach line {{HELO test.example} {MAIL FROM:<sender@remote.test>} {RCPT TO:<mixed@example.test>} DATA} {
        puts $socket $line
        gets $socket reply
        if {[string index $reply 0] ni {2 3}} {error $reply}
    }
    puts $socket "From: sender@remote.test\nTo: mixed@example.test\n\nBody\n."
    gets $socket reply
    puts $socket QUIT
    gets $socket
    close $socket
    string range $reply 0 2
} -result 250

test alias-proxy-received {streaming relay and TLS receiving sink each add a trace header} -constraints fullsuite -body {
    set f [open [file join $::env(ALIAS_TEST_HOME) sink-messages.list]]
    fconfigure $f -translation lf -encoding utf-8
    try {set messages [read $f]} finally {close $f}
    set data [lindex $messages 0 1]
    list [regexp -all {Received: from \[127\.0\.0\.1\]} $data] \
         [regexp {with ESMTPS\r\n} $data] [regexp {with SMTP\r\n} $data]
} -result {2 1 1}

test alias-proxy-3 {native STARTTLS sink receives the expected envelopes and headers} -constraints fullsuite -body {
    set channel [open [file join $::env(ALIAS_TEST_HOME) sink-messages.list]]
    fconfigure $channel -translation lf -encoding utf-8
    set messages [read $channel]
    close $channel
    file delete [file join $::env(ALIAS_TEST_HOME) sink-messages.list]
    list [llength $messages] [lsort [lindex $messages 0 0]] [lsort [lindex $messages 1 0]] \
        [expr {[string first "To: webmaster@example.test\r\n" [lindex $messages 0 1]] >= 0}] \
        [expr {[string first "To: mixed@example.test\r\n" [lindex $messages 1 1]] >= 0}]
} -result {2 {one@remote.test two@remote.test} {one@remote.test two@other.test} 1 1}

test alias-proxy-event-servers {recycled connections retain per-server event log ownership} -constraints fullsuite -body {
    source [file join [file dirname [info script]] event-log-support.tcl]
    set result {}
    foreach {name expected minimum} {events.log test 4 sink-events.log sink 4} {
        set path [file join $::env(ALIAS_TEST_HOME) $name]
        set servers {}
        for {set i 0} {$i < 200} {incr i} {
            set channel [open $path]
            try {set text [read $channel]} finally {close $channel}
            set lines [split [string trimright $text \n] \n]
            if {[llength $lines] >= $minimum} {break}
            after 10
        }
        foreach line $lines {lappend servers [dict get [event_parse_line $line] server]}
        lappend result [expr {[llength $lines] >= $minimum}] [lsort -unique $servers]
    }
    set result
} -result {1 test 1 sink}

test alias-proxy-outcomes {relay acceptance retains reply and DATA bytes, without extra QUIT outcomes} -constraints fullsuite -body {
    set path [file join $::env(ALIAS_TEST_HOME) events.log]
    set ends {}
    for {set i 0} {$i < 200} {incr i} {
        set channel [open $path]
        try {set text [read $channel]} finally {close $channel}
        set ends {}
        foreach line [split [string trimright $text \n] \n] {
            if {[dict get [event_parse_line $line] event] eq "transaction"} {lappend ends $line}
        }
        if {[llength $ends] >= 2} {break}
        after 10
    }
    set result [list [llength $ends]]
    foreach line $ends {
        lappend result [dict get [event_parse_line $line] details reason] \
            [regexp {message-bytes=[1-9][0-9]*} $line] \
            [regexp {relay-accepted=true relay-reply=250} $line]
    }
    set result
} -result {2 relay-accepted 1 1 relay-accepted 1 1}

set failures $::tcltest::numTests(Failed)
cleanupTests
puts "ALIAS_TEST_FAILURES=$failures"
ns_shutdown
vwait forever

# Local variables:
#    mode: tcl
#    tcl-indent-level: 4
#    indent-tabs-mode: nil
# End:

#
# Basic submission through the local nssmtpd listener, without HTTP or an
# external relay. Run through make test / run-alias-tests.tcl.
if {![info exists ::env(ALIAS_TEST_MODE)] || $::env(ALIAS_TEST_MODE) ne "basic"} {return}
package require tcltest 2.2
namespace import ::tcltest::*
configure {*}$argv
nsv_set alias-test policy {}

test nssmtpd-session-validation {session commands reject missing and nonexistent IDs} -body {
    set failures {}
    foreach command {logevent gethdr gethdrs getbody getfrom getfromdata setfrom
        setfromdata getrcpt getrcptdata addrcpt setrcptdata delrcpt setflag
        unsetflag getflag setreply getline dump} {
        foreach args [list {} {-1}] {
            try {
                ns_smtpd $command {*}$args
                lappend failures "$command accepted $args"
            } on error {message} {
                set expected [expr {$args eq "" ? "wrong # args:*" : "invalid session id: -1"}]
                if {![string match $expected $message]} {lappend failures $message}
            }
        }
    }
    set failures
} -result {}

proc basic_recipients {} {
    set addresses {}
    foreach recipient [nsv_get alias-test recipients] {
        lappend addresses [lindex $recipient 0]
    }
    return [lsort $addresses]
}

test nssmtpd-1.1 {ns_sendmail to one recipient through nssmtpd} -body {
    ns_sendmail -to one@example.test -from sender@example.test -subject hi -body {some text}
    list [basic_recipients] [nsv_get alias-test from] \
        [string match {*some text*} [nsv_get alias-test body]]
} -result {one@example.test sender@example.test 1}

test nssmtpd-1.2 {ns_sendmail to two recipients through nssmtpd} -body {
    ns_sendmail -to {one@example.test, two@example.test} -from sender@example.test -subject hi -body {two recipients}
    list [basic_recipients] [string match {*two recipients*} [nsv_get alias-test body]]
} -result {{one@example.test two@example.test} 1}

test nssmtpd-1.3 {ns_sendmail dot-stuffing does not terminate DATA early} -body {
    ns_sendmail -to one@example.test -from sender@example.test -subject hi \
        -body "some text\n.and more\n.\nafter the dot"
    # The current receive API exposes the raw, still dot-stuffed DATA.
    set data [nsv_get alias-test body]
    list [string match {*..and more*} $data] [string match {*after the dot*} $data]
} -result {1 1}

test nssmtpd-2.0 {ns_smtpd send to one recipient preserves data-variable scope} -body {
    set message "From: sender@example.test\r\nTo: one@example.test\r\n\r\nBody"
    ns_smtpd send sender@example.test one@example.test message 127.0.0.1 $::env(ALIAS_TEST_PORT)
    list [basic_recipients] [nsv_get alias-test from]
} -result {one@example.test sender@example.test}

test nssmtpd-2.1 {ns_smtpd send to two recipients with dot-stuffed DATA} -body {
    set message "From: sender@example.test\r\n\r\n.leading\r\n.\r\nafter the dot"
    ns_smtpd send sender@example.test {one@example.test two@example.test} message 127.0.0.1 $::env(ALIAS_TEST_PORT)
    list [basic_recipients] [string match {*after the dot*} [nsv_get alias-test body]]
} -result {{one@example.test two@example.test} 1}

test nssmtpd-received {listener prepends its trace header and retains existing headers and body} -body {
    set message "Received: from original.example by upstream.example; Wed, 30 Sep 2026 00:00:00 +0000\r\nSubject: trace\r\n\r\nBody"
    ns_smtpd send sender@example.test one@example.test message 127.0.0.1 $::env(ALIAS_TEST_PORT)
    set data [nsv_get alias-test body]
    list [regexp {^Received: from \[127\.0\.0\.1\]\r\n\tby [A-Za-z0-9.-]+ \(nssmtpd\) with SMTP\r\n\tid [0-9-]+\.[0-9]+; [^\r\n]+ GMT\r\nReceived: from original\.example} $data] \
         [expr {[string first $message $data] >= 0}]
} -result {1 1}

set failures $::tcltest::numTests(Failed)
cleanupTests
puts "ALIAS_TEST_FAILURES=$failures"
ns_shutdown
vwait forever

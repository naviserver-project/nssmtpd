# -*- Tcl -*-
# Both text formats run through the configured module hook in separate servers.
if {![info exists ::env(ALIAS_TEST_MODE)] || $::env(ALIAS_TEST_MODE) ni {files filevirtual}} {return}
package require tcltest 2.2
namespace import ::tcltest::*
configure {*}$argv
set format [expr {$::env(ALIAS_TEST_MODE) eq "files" ? "aliases" : "virtual"}]
testConstraint config_aliasformat_virtual [expr {$format eq "virtual"}]
set aliasfile [file join $::env(ALIAS_TEST_HOME) aliases]
proc write_map {text} {
    set channel [open $::aliasfile.new w]
    try {puts $channel $text} finally {close $channel}
    file rename -force $::aliasfile.new $::aliasfile
}
proc entries {pairs} {
    set text "# Forwarding addresses\n\n"
    foreach {key targets} $pairs {
        if {$::format eq "aliases"} {
            append text "$key: $targets\n"
        } else {
            append text "$key@example.test $targets\n"
        }
    }
    return $text
}
proc normal_map {} {
    write_map [entries {webmaster {team,
    two@remote.test} team one@remote.test identity identity}]
}
proc recipient_reply {} {
    set channel [socket 127.0.0.1 $::env(ALIAS_TEST_PORT)]
    fconfigure $channel -translation crlf -buffering line
    try {
        gets $channel
        foreach command {{HELO example.test} {MAIL FROM:<sender@remote.test>} {RCPT TO:<webmaster@example.test>}} {
            puts $channel $command
            flush $channel
            gets $channel reply
        }
        return [string range $reply 0 2]
    } finally {close $channel}
}

test file-alias-1 {comments, continuation, bare targets, chains and deduplication} -body {
    normal_map
    ns_smtpd resolve {webmaster@example.test one@remote.test}
} -result {one@remote.test two@remote.test}

test file-alias-2 {case insensitive keys and configured domains} -body {
    normal_map
    ns_smtpd resolve WEBMASTER@EXAMPLE.TEST
} -result {one@remote.test two@remote.test}

test file-alias-3 {unmapped addresses and other domains pass through} -body {
    normal_map
    ns_smtpd resolve {unknown@example.test webmaster@remote.test}
} -result {unknown@example.test webmaster@remote.test}

test file-alias-4 {identity destination terminates expansion} -body {
    normal_map
    ns_smtpd resolve identity@example.test
} -result identity@example.test

test file-alias-5 {cycles fail without falling back} -body {
    write_map [entries {webmaster team team webmaster}]
    list [catch {ns_smtpd resolve webmaster@example.test} message] $message [recipient_reply]
} -result {1 {alias cycle at webmaster@example.test} 451}

test file-alias-6 {unsupported destinations are errors, never executable} -body {
    set results {}
    foreach value {{|command} /tmp/mail :include:/tmp/list {"User" <a@remote.test>} {a@remote.test,} {$env(HOME)}} {
        write_map [entries [list webmaster $value]]
        lappend results [catch {ns_smtpd resolve webmaster@example.test}]
    }
    set results
} -result {1 1 1 1 1 1}

test file-alias-7 {duplicate keys fail case insensitively} -body {
    write_map [entries {webmaster a@remote.test WEBMASTER b@remote.test}]
    catch {ns_smtpd resolve webmaster@example.test} message
    string match {*duplicate*} $message
} -result 1

test file-alias-8 {orphan continuation and malformed lines fail} -body {
    set results {}
    foreach text {{  webmaster a@remote.test} {no separator here}} {
        write_map $text
        lappend results [catch {ns_smtpd resolve webmaster@example.test}]
    }
    set results
} -result {1 1}

test file-alias-9 {missing file fails in scope, external recipient bypasses file} -body {
    file delete -force $aliasfile
    list [catch {ns_smtpd resolve webmaster@example.test}] [recipient_reply] [ns_smtpd resolve webmaster@remote.test]
} -result {1 451 webmaster@remote.test}

test file-alias-10 {replacement file is observed on next lookup} -body {
    normal_map
    set before [ns_smtpd resolve webmaster@example.test]
    write_map [entries {webmaster new@remote.test}]
    list $before [ns_smtpd resolve webmaster@example.test]
} -result {{one@remote.test two@remote.test} new@remote.test}

test file-alias-11 {module recipient limit still applies} -body {
    write_map [entries {webmaster {a@remote.test,b@remote.test,c@remote.test,d@remote.test}}]
    catch {ns_smtpd resolve webmaster@example.test} message options
    list [dict get $options -errorcode] [recipient_reply]
} -result {{NSSMTPD ALIAS LIMIT} 452}

test file-alias-12 {long chains fail within bounded depth} -body {
    set pairs {}
    for {set i 0} {$i < 40} {incr i} {lappend pairs user$i user[expr {$i+1}]}
    write_map [entries $pairs]
    catch {ns_smtpd resolve user0@example.test} message
    string match {*resolver limit*} $message
} -result 1

test file-alias-13 {virtual exact entry precedes catch-all; identity exempts destination} -constraints config_aliasformat_virtual -body {
    write_map "webmaster@example.test one@remote.test\n@example.test fallback@remote.test\nidentity@example.test identity@example.test"
    ns_smtpd resolve {webmaster@example.test unknown@example.test identity@example.test}
} -result {one@remote.test fallback@remote.test identity@example.test}

test file-alias-work {wide recursive maps have a total work bound} -body {
    set pairs {}
    for {set i 0} {$i < 15} {incr i} {
        set next user[expr {$i+1}]
        lappend pairs user$i "$next,$next"
    }
    write_map [entries $pairs]
    catch {ns_smtpd resolve user0@example.test} message
    set message
} -result {alias expansion exceeds file resolver limit}

test file-virtual-spaces {space-separated group does not block unrelated lookup} -constraints config_aliasformat_virtual -body {
    write_map "gustafn@example.test neumann@remote.test\nconference2026@example.test bernd.simon@km.test harald.oehlmann@elmicron.test neumann@remote.test stefan.sobernig@wu.test"
    list [ns_smtpd resolve gustafn@example.test] \
        [smtpd::resolvefilealiases -format virtual -file $aliasfile -domains {example.test} -recipient conference2026@example.test]
} -result {neumann@remote.test {bernd.simon@km.test harald.oehlmann@elmicron.test neumann@remote.test stefan.sobernig@wu.test}}

test file-virtual-mixed {spaces, tabs, commas, continuations and duplicates} -constraints config_aliasformat_virtual -body {
    write_map "webmaster@example.test one@remote.test\ttwo@remote.test,\n    three@remote.test one@remote.test"
    ns_smtpd resolve webmaster@example.test
} -result {one@remote.test two@remote.test three@remote.test}

test file-alias-empty-groups {whitespace must not hide empty comma entries} -body {
    set results {}
    foreach value {{,one@remote.test} {one@remote.test, ,two@remote.test} {one@remote.test, }} {
        write_map [entries [list webmaster $value]]
        lappend results [catch {ns_smtpd resolve webmaster@example.test}]
    }
    set results
} -result {1 1 1}

test file-alias-14 {actual outgoing envelope uses file aliases and preserves header} -body {
    normal_map
    nsv_set alias-sink messages {}
    nsv_set alias-sink error ""
    set sink [ns_connchan listen -bind 127.0.0.1 0 alias_sink_accept]
    try {
        set message "To: webmaster@example.test\r\n\r\nBody"
        ns_smtpd send sender@remote.test webmaster@example.test message 127.0.0.1 [dict get $sink port]
        set captured [lindex [nsv_get alias-sink messages] 0]
        list [lindex $captured 0] [string match {*To: webmaster@example.test*} [lindex $captured 1]] [nsv_get alias-sink error]
    } finally {ns_connchan close [dict get $sink channel]}
} -result {{one@remote.test two@remote.test} 1 {}}

test file-alias-15 {actual incoming DATA sees file-expanded recipients} -body {
    normal_map
    # Submit an original address over raw SMTP so only the receiver expands it.
    set channel [socket 127.0.0.1 $::env(ALIAS_TEST_PORT)]
    fconfigure $channel -translation crlf -buffering line
    try {
        gets $channel
        foreach command {{HELO example.test} {MAIL FROM:<sender@remote.test>} {RCPT TO:<webmaster@example.test>} DATA} {
            puts $channel $command
            flush $channel
            gets $channel
        }
        puts $channel "To: webmaster@example.test\n\nBody\n."
        flush $channel
        gets $channel reply
        list [string range $reply 0 2] [lsort [lmap rcpt [nsv_get alias-test recipients] {lindex $rcpt 0}]]
    } finally {close $channel}
} -result {250 {one@remote.test two@remote.test}}

test file-options-order {named options are order independent} -body {
    normal_map
    set results {}
    foreach address {webmaster@example.test identity@example.test unknown@example.test other@remote.test} {
        set a [smtpd::resolvefilealiases -format $format -file $aliasfile -domains example.test -recipient $address]
        set b [smtpd::resolvefilealiases -recipient $address -domains example.test -file $aliasfile -format $format]
        lappend results [expr {$a eq $b}]
    }
    set results
} -result {1 1 1 1}

test file-options-path {file names and domain lists remain single literal arguments} -body {
    normal_map
    set filename [file join $::env(ALIAS_TEST_HOME) {map [literal] with spaces}]
    file copy -force $aliasfile $filename
    try {
        smtpd::resolvefilealiases -file $filename -domains {other.test EXAMPLE.TEST} -format $format -recipient webmaster@example.test
    } finally {file delete $filename}
} -result {one@remote.test two@remote.test}

test file-options-default {omitting format selects virtual} -constraints config_aliasformat_virtual -body {
    normal_map
    smtpd::resolvefilealiases -file $aliasfile -domains example.test -recipient webmaster@example.test
} -result {one@remote.test two@remote.test}

test file-options-invalid {invalid options, booleans and missing recipient fail} -body {
    set errors {}
    set options [list -format $format -file $aliasfile -domains example.test]
    foreach arguments [list \
        [list {*}$options -unknown yes -recipient webmaster@example.test] \
        [list -format invalid -file $aliasfile -domains example.test -recipient webmaster@example.test] \
        [list {*}$options -rejectunknown invalid -recipient webmaster@example.test] \
        $options \
        [list {*}$options -recipient webmaster@example.test extra]] {
        try {smtpd::resolvefilealiases {*}$arguments; lappend errors 0} on error {message options} {lappend errors 1}
    }
    set errors
} -result {1 1 1 1 1}

test file-options-missing {missing option and module setting raises an error} -constraints config_aliasformat_virtual -body {
    set errors {}
    foreach arguments [list \
        [list -domains example.test -recipient webmaster@example.test] \
        [list -file $aliasfile -recipient webmaster@example.test]] {
        try {smtpd::resolvefilealiases {*}$arguments; lappend errors 0} on error {message options} {
            lappend errors [string match {provide -* or configure alias*} $message]
        }
    }
    set errors
} -result {1 1}

test file-options-settings {omitted options inherit settings; empty domains overrides scope} -body {
    normal_map
    if {$format eq "aliases"} {
        list [smtpd::resolvefilealiases -recipient webmaster@example.test] \
            [smtpd::resolvefilealiases -domains {} -rejectunknown true -recipient unknown@example.test]
    } else {
        list [smtpd::resolvefilealiases -file $aliasfile -domains example.test -recipient webmaster@example.test] \
            [smtpd::resolvefilealiases -file $aliasfile -domains {} -rejectunknown true -recipient unknown@example.test]
    }
} -result {{one@remote.test two@remote.test} unknown@example.test}

test file-options-override {explicit options override module defaults} -body {
    set otherfile [file join $::env(ALIAS_TEST_HOME) {override map}]
    set f [open $otherfile w]
    try {puts $f {user@other.test override@remote.test}} finally {close $f}
    try {
        smtpd::resolvefilealiases -format virtual -file $otherfile -domains other.test -recipient user@other.test
    } finally {file delete $otherfile}
} -result override@remote.test

test file-options-recipient {dash-prefixed recipient is an option value and needs no separator} -body {
    write_map [entries {-test one@remote.test}]
    list [smtpd::resolvefilealiases -format $format -file $aliasfile -domains example.test -recipient -test@example.test] \
        [ns_smtpd resolve -test@example.test]
} -result {one@remote.test one@remote.test}

test file-rejectunknown {strict lookup distinguishes unknown, identity and out-of-scope addresses} -body {
    normal_map
    set prefix [list smtpd::resolvefilealiases -format $format -file $aliasfile -domains example.test -rejectunknown true]
    set results {}
    foreach address {webmaster@example.test identity@example.test unknown@example.test other@remote.test} {
        try {lappend results [{*}$prefix -recipient $address]} on error {message options} {
            lappend results [dict get $options -errorcode]
        }
    }
    set results
} -result {{one@remote.test two@remote.test} identity@example.test {NSSMTPD ALIAS UNKNOWN} other@remote.test}

test file-rejectunknown-override {passthrough override wins over a strict callback prefix} -body {
    normal_map
    set prefix [list smtpd::resolvefilealiases -format $format -file $aliasfile -domains example.test -rejectunknown true]
    smtpd::test_resolvealiases $prefix unknown@example.test 10 true
} -result unknown@example.test

proc bounce_test_callback {recipient} {
    switch -- $recipient {
        valid@example.test {return true}
        broken@example.test {error "token store unavailable"}
        nonboolean@example.test {return nonsense}
        default {return false}
    }
}
proc bounce_resolve {recipient args} {
    smtpd::resolvefilealiases -format $::format -file $::aliasfile \
        -domains example.test -bouncevalidproc bounce_test_callback -bouncetarget webmaster@example.test \
        -rejectunknown true -recipient $recipient {*}$args
}
test file-bounce-expand {validated bounce expands and deduplicates ordinary aliases} -body {
    normal_map
    bounce_resolve valid@example.test
} -result {one@remote.test two@remote.test}
test file-bounce-passthrough {fallback also runs for outgoing and resolve operations} -body {
    normal_map
    bounce_resolve valid@example.test -rejectunknown false
} -result {one@remote.test two@remote.test}
test file-bounce-empty {false result retains unknown-recipient behaviour} -body {
    normal_map
    try {bounce_resolve invalid@example.test} trap {NSSMTPD ALIAS UNKNOWN} {} {
        bounce_resolve invalid@example.test -rejectunknown false
    }
} -result invalid@example.test
test file-bounce-precedence {ordinary aliases take precedence over a failing callback} -body {
    normal_map
    bounce_resolve webmaster@example.test -bouncevalidproc {error unexpected-callback}
} -result {one@remote.test two@remote.test}
test file-bounce-scope {out-of-scope addresses do not invoke fallback} -body {
    normal_map
    bounce_resolve other@remote.test -bouncevalidproc {error unexpected-callback}
} -result other@remote.test
test file-bounce-error {lookup errors propagate without passthrough} -body {
    normal_map
    bounce_resolve broken@example.test -rejectunknown false
} -returnCodes error -result {token store unavailable}
test file-bounce-cycle {cycles through fallback and ordinary aliases fail} -body {
    write_map [entries {webmaster valid@example.test}]
    bounce_resolve valid@example.test
} -returnCodes error -result {alias cycle at valid@example.test}
test file-bounce-invalid {invalid and self-referencing destinations fail} -body {
    normal_map
    set results {}
    foreach target [list valid@example.test "a@remote.test\r\nQUIT" {a@remote.test b@remote.test} {}] {
        try {
            bounce_resolve valid@example.test -bouncetarget $target
            lappend results accepted
        } on error {} {lappend results rejected}
    }
    set results
} -result {rejected rejected rejected rejected}
test file-bounce-maxrcpt {fallback respects the shared final-recipient limit} -body {
    normal_map
    set prefix [list smtpd::resolvefilealiases -format $format -file $aliasfile \
                    -domains example.test -bouncevalidproc bounce_test_callback -bouncetarget webmaster@example.test]
    try {smtpd::test_resolvealiases $prefix valid@example.test 1 true} on error {message options} {
        dict get $options -errorcode
    }
} -result {NSSMTPD ALIAS LIMIT}

test file-bounce-config {configured callback is used; empty option disables it} -body {
    normal_map
    set section [ns_configsection ns/server/[ns_info server]/module/nssmtpd]
    set index [ns_set size $section]
    ns_set put $section bouncetarget webmaster@example.test
    ns_set put $section bouncevalidproc bounce_test_callback
    try {
        list [ns_smtpd resolve valid@example.test] \
            [bounce_resolve valid@example.test -rejectunknown false -bouncevalidproc {}]
    } finally {ns_set delete $section $index; ns_set delete $section $index}
} -result {{one@remote.test two@remote.test} valid@example.test}

test file-bounce-smtp-error {callback failure returns SMTP 451} -body {
    normal_map
    ns_eval {proc ::bounce_smtp_error args {error "token store unavailable"}}
    set section [ns_configsection ns/server/[ns_info server]/module/nssmtpd]
    set index [ns_set size $section]
    ns_set put $section bouncetarget webmaster@example.test
    ns_set put $section bouncevalidproc ::bounce_smtp_error
    set channel [socket 127.0.0.1 $::env(ALIAS_TEST_PORT)]
    fconfigure $channel -translation crlf -buffering line
    try {
        gets $channel
        foreach command {{HELO example.test} {MAIL FROM:<>} {RCPT TO:<broken@example.test>}} {
            puts $channel $command
            gets $channel reply
        }
        string range $reply 0 2
    } finally {
        close $channel
        ns_set delete $section $index; ns_set delete $section $index
    }
} -result 451

test file-bounce-nonboolean {invalid validator return is a lookup error} -body {
    normal_map
    bounce_resolve nonboolean@example.test
} -returnCodes error -result {bounce validator must return a boolean}

test file-bounce-missing-target {configured validator requires a target even for known aliases} -body {
    normal_map
    bounce_resolve webmaster@example.test -bouncetarget {}
} -returnCodes error -result {bouncevalidproc requires a bare envelope address in bouncetarget}

set failures $::tcltest::numTests(Failed)
file delete -force $aliasfile
cleanupTests
puts "ALIAS_TEST_FAILURES=$failures"
ns_shutdown
vwait forever

# Local variables:
#    mode: tcl
#    tcl-indent-level: 4
#    indent-tabs-mode: nil
# End:
